// One shell and the built-in compact bar. No applications auto-launch, no
// project topology is assumed, and the shell/cwd are inherited from Zellij.
// Try `zellij -s simple -n minimal`, or select layout "minimal" locally.
// Unlike the default two-tab layout, this has no separate recovery safety tab:
// exiting the last resurrected foreground application can end the session.
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    pane
}
