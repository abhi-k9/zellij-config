// ═══════════════════════════════════════════════════════════════════════════
//  Zellij configuration — targeting v0.45.1
//  Format: KDL v1  (https://kdl.dev) — like JSON, but for humans
//
//  This file lives at:
//    Linux   : ~/.config/zellij/config.kdl  (else $XDG_CONFIG_HOME/zellij/)
//    macOS   : ~/.config/zellij/config.kdl  (checked first; the legacy
//              ~/Library/Application Support/org.Zellij-Contributors.Zellij/
//              location also works but is shadowed if ~/.config/zellij exists)
//    Windows : %APPDATA%\Zellij\config\config.kdl
//  (Or wherever $ZELLIJ_CONFIG_DIR / --config-dir point.)
//
//  Plain Zellij watches this file live. The zj launcher uses a private startup
//  snapshot; restart a session to apply changes through that launcher.
//  `zellij setup --check` validates it, but unknown keys are silently ignored:
//  compare spellings against `zellij setup --dump-config`.
//
//  HOW TO READ IT: each comment says what a setting does and why it is set;
//  longer rationale lives in docs/CONFIGURATION.md (the section is named). A
//  trailing `// default` marks a line that restates zellij 0.45.1's own
//  default — pinned so the file documents itself; deleting it changes nothing.
// ═══════════════════════════════════════════════════════════════════════════


// ─── Appearance ────────────────────────────────────────────────────────────

// Built into zellij — no theme file needed. Other flavors: catppuccin-latte,
// catppuccin-frappe, catppuccin-macchiato. All built-ins:
// https://zellij.dev/documentation/theme-list.html
theme "catppuccin-mocha"

// Follow the terminal's light/dark mode (0.44.2+; the terminal must report it
// via CSI 2031 — WezTerm, Ghostty, Kitty, …). Set BOTH lines: with only one,
// the static `theme` above stays in charge.
// theme_dark  "catppuccin-mocha"
// theme_light "catppuccin-latte"
//
// explicit_theme_hue (0.45.1) PINS the hue instead: "dark" always uses
// theme_dark, "light" always theme_light, and the terminal's reports are
// ignored. It is an override, not a fallback for terminals that stay silent —
// while it is set, nothing auto-switches.
// explicit_theme_hue "dark"

// Frames around panes. Toggle per session with Ctrl+p, z. The zjstatus layout
// wants this false (see the ⚠ FRAMES note in layouts/zjstatus.kdl).
pane_frames true                        // default

// Frame style (0.45.0+): "full" border, "titles" (a single title line, shown
// only when a tab has >1 pane — the 0.45 default) or "none". Pinned to "full"
// for a stable pre-0.45 look, and because rounded_corners only applies to a
// full border. Runtime: `zellij action set-pane-frame-style full|titles|none`.
pane_frame_style "full"

ui {
    pane_frames {
        rounded_corners true            // only visible with pane_frame_style "full"
        hide_session_name false         // default — true hides the session name in frame titles
    }
}

show_startup_tips true                  // default — turn off once the keys are familiar
show_release_notes true                 // default — shown once per new zellij version


// ─── Behavior ──────────────────────────────────────────────────────────────

// "normal": zellij's keys are live. "locked": every key goes to the app until
// you unlock (Ctrl+g by default — see Keybindings).
default_mode "normal"                   // default

// Terminal window closed: "detach" keeps the session running (come back with
// `zellij attach --create NAME`); "quit" ends it.
on_force_close "detach"                 // default

// Resolved against layouts/ first, then zellij's built-ins (compact, welcome,
// …). "default" is OUR layouts/default.kdl: compact-bar plus two tabs, "main"
// and "shell" (why: README "Session recovery"). Opt-in alternative: "zjstatus"
// — then also set pane_frames false (see layouts/zjstatus.kdl).
default_layout "default"

// Unset = $SHELL. Set it for a different or non-login shell, e.g. "fish",
// "/bin/zsh", "pwsh", "C:\\Windows\\System32\\cmd.exe".
// default_shell "fish"

// Scrollback lines per pane. Raise to 50000+ for heavy log reading.
scroll_buffer_size 10000                // default

// Arrange new panes with the tab's swap layouts — the arrangements Alt+[ / Alt+]
// cycle through, from layouts/*.swap.kdl. false = new panes split the focused one.
auto_layout true                        // default

// Resizing a pane beyond a certain size (Alt+= / Alt+-) stacks its neighbours.
stacked_resize true                     // default


// ─── Clipboard & Mouse ─────────────────────────────────────────────────────

// Copy goes through OSC52 while copy_command is unset: the terminal writes the
// clipboard, which works in most terminals and over SSH — the portable choice
// (README "Clipboard"). Only on a local-only box where OSC52 fails, uncomment ONE
// (each is a single-OS program and can't reach your laptop over SSH):
// copy_command "pbcopy"                          // macOS
// copy_command "wl-copy"                         // Linux Wayland
// copy_command "xclip -selection clipboard"      // Linux X11
// copy_command "clip.exe"                        // Windows / WSL→Windows

copy_clipboard "system"                 // default — "primary" = X11/Wayland middle-click buffer; ignored when copy_command is set
copy_on_select true                     // default — releasing a mouse selection copies it

// Click to focus, drag a border to resize, wheel to scroll (since 0.45 the
// wheel also enters Scroll mode — see scroll_mode_sync below). Hold Shift to
// bypass zellij and use the terminal's own selection.
mouse_mode true                         // default

// Hover effects: frame highlight and help text over the pane under the mouse.
// Related keys, unset here (all default true): mouse_hover_tips (only the
// help-text tips), advanced_mouse_actions (hover effects AND pane grouping),
// mouse_scroll_resize (Ctrl+wheel resizes; checklist item 3 relies on it).
mouse_hover_effects true                // default

focus_follows_mouse false               // default — true focuses a pane on hover (i3/sway feel)
mouse_click_through false               // default — true lets the focusing click also reach the app


// ─── Sessions & Resurrection ───────────────────────────────────────────────
// Rationale, the nvim caveat and the hard-guarantee alternatives (an nvim
// session plugin, or a post_command_discovery_hook — not used here): README
// "Session recovery". zellij 0.45.1 caveats: README "Known issues (0.45.1)".

// Save each session (tabs, panes, cwds, running commands) and resurrect it.
// After a crash or reboot use `zellij attach --create NAME` for a named session.
// Plain `zellij` starts a fresh session. A resurrected nvim has no
// shell under it; layouts/default.kdl's extra "shell" tab keeps `:qa` from
// ending the session.
session_serialization true              // default

// Also save each pane's visible screen? Off, so resurrected panes come back
// clean. ⚠ NAME TRAP: zellij's docs call this `pane_viewport_serialization`
// (docs bug, zellij-org/zellij#3987) — that name parses and is silently
// ignored. Keep `serialize_pane_viewport`; `zellij setup --dump-config` has it.
serialize_pane_viewport false           // default

// Scrollback lines saved per pane, 0 = the whole buffer (capped at
// scroll_buffer_size). Inert while serialize_pane_viewport is false.
scrollback_lines_to_serialize 0

// Seconds between saves.
serialization_interval 60

// No shared session name is forced: independent launches can have independent
// working directories. Use `zellij attach --create NAME` for intentional reuse,
// or select the local "classic" profile to restore the singleton "main" workflow.
// Project sessions: `zellij -s proj -n dev`, not `--session proj --layout dev`
// (that adds tabs to an existing session). See docs/CONFIGURATION.md.
attach_to_session false

osc8_hyperlinks true                    // default — clickable OSC8 links in pane output

// Flash the pane/tab frame on BEL; a bell in an unfocused tab adds [!] to its name.
visual_bell true                        // default

// Forward desktop notifications (OSC 9/99/777) from panes to your terminal, e.g.
// a long build finishing in a background pane. "auto" uses OSC 99 where the
// terminal supports it, else OSC 9; also "osc9", "osc99", "bell" (ring
// instead) and "off".
host_notification_protocol "auto"

// Since 0.45.0 the mouse wheel enters Scroll mode. Uncomment for the pre-0.45
// behavior (the wheel scrolls, the mode stays):
// scroll_mode_sync false

// Richer key events for apps (Ctrl+Shift+letter, key release) on terminals
// that support the kitty keyboard protocol.
support_kitty_keyboard_protocol true    // default

// ASCII-friendly plugin UI — set it if the status bar shows broken glyphs
// (a font without Nerd Font / powerline arrows).
// simplified_ui true


// ─── Environment ───────────────────────────────────────────────────────────

// Exported into every pane zellij spawns (not into zellij itself). zellij
// already sets $ZELLIJ and $ZELLIJ_SESSION_NAME — don't set ZELLIJ here, it
// would shadow the internal value.
env {
    // RUST_BACKTRACE "1"               // optional Rust diagnostics; classic profile enables it
    // EDITOR "nvim"
}

// Scroll mode `e` opens the scrollback in $EDITOR / $VISUAL; with neither set
// it silently returns to Normal. Set $EDITOR in your environment (kept out of
// this file so it stays cross-platform), or pin one here:
// scrollback_editor "nvim"     // Linux/macOS: vim, micro, hx…  Windows: "notepad", "code"


// ─── Keybindings ───────────────────────────────────────────────────────────
// zellij is modal: Ctrl+<letter> enters a mode, single keys act inside it.
//   Defaults: https://zellij.dev/documentation/keybindings-default.html
//   Actions:  https://zellij.dev/documentation/keybindings-possible-actions.html
// The defaults are KEPT (no `clear-defaults=true`); the blocks below only add
// or remove keys. `shared_except "locked"` = every mode except Locked.

keybinds {
    // Ctrl+q (quit) is a fat-finger of Ctrl+w in shells. Quit deliberately with
    // Ctrl+o, q (below), or detach with Ctrl+o, d. Delete this line to keep it.
    unbind "Ctrl q"

    // LOCK TOGGLE uses Zellij's standard Ctrl+g. Locking is manual: press it
    // entering a full-screen application, and again on leaving. If your app
    // needs Ctrl+g, choose lock_key "F12" in local preferences (the classic
    // profile does this). Both contexts are rendered together so either key
    // works consistently; confirm your terminal forwards the selected key.
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }
    shared_except "locked" {
        bind "Ctrl g" { SwitchToMode "Locked"; }
    }

    // Session mode (Ctrl+o) additions, next to zellij's own launchers. 0.45.1
    // already uses d, w, c, l, p, a, s, f, [ and ] there; q, m, h, t and e are free.
    session {
        bind "q" { Quit; }                    // replaces the unbound Ctrl+q

        // monocle (find files and contents) in a floating pane, rooted at the
        // focused pane's directory; Esc hides it.
        bind "m" {
            LaunchOrFocusPlugin "monocle" { floating true; };
            SwitchToMode "Normal"
        }

        // Built-in keybinding/configuration screen. No third-party popup binary
        // is needed; Ctrl+o, c remains Zellij's default entry point too.
        bind "h" {
            LaunchOrFocusPlugin "configuration" { floating true; };
            SwitchToMode "Normal"
        }

        // Task runners and config editors remain explicit local choices. KDL
        // Run actions do not expand environment variables or ~, and shell
        // wrappers are platform-specific. See docs/CONFIGURATION.md for local
        // preferences and plugin caveats before adding application launchers.
    }
}


// ─── Plugins ───────────────────────────────────────────────────────────────
// Aliases give a plugin URL a short name for layouts, binds and
// `zellij plugin -- <alias>`. They extend zellij's built-in aliases
// (compact-bar, session-manager, welcome-screen, …). An alias only registers a
// name: nothing here starts until a bind or a layout uses it.
//
// VERSIONS ARE PINNED: zellij caches each .wasm by URL, so `releases/latest`
// would give two machines different builds, and a future build may need a
// newer zellij. Use `tools/manage.py versions update` to change pins and backups.
// The checked-in zj launcher prefers verified downloads and falls back to the
// bundled plugins/ copies when fetching fails. ZJ_OFFLINE=1 skips network work.
// Plain zellij uses these HTTPS aliases and its own cache; it has no bundled
// fallback mechanism. See README.md for direct-clone startup commands.
//
// Copy each tag verbatim from its releases page — the formats differ upstream:
// zjstatus and monocle use `vX.Y.Z`; multitask follows the zellij version.
plugins {
    // https://github.com/dj95/zjstatus — status bar used by layouts/zjstatus.kdl.
    // v0.25.0 needs zellij >= 0.45.0 (it fixes the 0.45 frame flicker).
    zjstatus location="https://github.com/dj95/zjstatus/releases/download/v0.25.0/zjstatus.wasm"

    // https://github.com/imsnif/monocle — fuzzy file/content finder (Ctrl+o, m).
    monocle location="https://github.com/imsnif/monocle/releases/download/v0.100.2/monocle.wasm"

    // https://github.com/leakec/multitask (moved from imsnif/multitask) —
    // "mini-CI". Released in lockstep with zellij: bump it with every upgrade.
    multitask location="https://github.com/leakec/multitask/releases/download/v0.45.1/multitask.wasm"


}

// To start a plugin with every session (in the background), add a block like
// `load_plugins { zjstatus; }` here. check.sh reports one as INFO, not an error.
