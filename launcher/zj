#!/bin/sh
# zellij-config launcher: literal argument forwarding into the shared helper.
set -eu
bin=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
helper=$bin/.zellij-config/manage.py
if [ ! -f "$helper" ]; then helper=$bin/../tools/manage.py; fi
if command -v python3 >/dev/null 2>&1; then python=python3
elif command -v python >/dev/null 2>&1; then python=python
else echo 'Python 3.10+ is required for zj; zellij itself can still be run directly.' >&2; exit 1; fi
exec "$python" "$helper" launch -- "$@"
