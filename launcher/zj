#!/bin/sh
# zellij-config launcher — zj
# ─────────────────────────────────────────────────────────────────────────────
#  zj — start zellij, checking the pinned plugins for updates about once a month.
#
#  Usage:
#    zj [zellij arguments…]      e.g. `zj`, `zj attach --create main`
#    zj --check-updates [FILE]   only report, for FILE (default: the config.kdl
#                                zellij loads); exit 0 = all current,
#                                1 = newer release(s), 2 = couldn't check
#
#  No plugin list to maintain: every
#  location="https://github.com/OWNER/REPO/releases/download/TAG/…" in the
#  config is compared with that repo's latest release, so a plugin added there
#  is covered automatically. Plugins loaded from disk (file:…, as after
#  setup.sh --offline) or from other hosts are listed as not checked.
#
#  A check is due 30 days after the last one that reached GitHub, or a day after
#  one that didn't (offline). When due, zj checks before starting zellij (about
#  a second) and, if a newer release exists, lists it and waits for Enter. It
#  never edits your config — updating stays a manual step (README "Updating a
#  pinned plugin"). ZJ_NO_UPDATE_CHECK=1 skips the check. The date of the next
#  check is kept in ${XDG_STATE_HOME:-~/.local/state}/zellij-config/; delete
#  that file to check on the next start. Windows: zj.cmd + zj.ps1.
# ─────────────────────────────────────────────────────────────────────────────
set -u

STAMP=${XDG_STATE_HOME:-$HOME/.local/state}/zellij-config/plugin-update-check
RECHECK_OK=2592000      # 30 days
RECHECK_FAILED=86400    # 1 day

# config_file — the config.kdl zellij loads: $ZELLIJ_CONFIG_FILE, else
# config.kdl in the dir `zellij setup --check` reports. Empty if unknown.
config_file() {
    if [ -n "${ZELLIJ_CONFIG_FILE:-}" ]; then printf '%s\n' "$ZELLIJ_CONFIG_FILE"; return; fi
    dir=$(zellij setup --check 2>/dev/null | sed -n 's/^\[CONFIG DIR\]: "\(.*\)"$/\1/p')
    if [ -n "$dir" ]; then printf '%s/config.kdl\n' "$dir"; fi
}

# latest_tag OWNER/REPO — the tag of the repo's latest release (GitHub leaves
# out prereleases and drafts), read from where github.com/…/releases/latest
# redirects; that page isn't subject to the API's rate limit. Prints "-" when
# GitHub answered but the repo has no release, nothing when it didn't answer.
latest_tag() {
    url="https://github.com/$1/releases/latest"
    if command -v curl >/dev/null 2>&1; then
        loc=$(curl -fsSI -o /dev/null -w '%{redirect_url}' --connect-timeout 3 --max-time 8 "$url" 2>/dev/null)
    elif command -v wget >/dev/null 2>&1; then
        loc=$(wget -S --spider -T 8 -t 1 "$url" 2>&1 | sed -n 's/^ *[Ll]ocation: *//p' | head -n 1)
    else
        loc=""
    fi
    loc=$(printf '%s' "$loc" | tr -d '\r')
    case "$loc" in
        */releases/tag/*) printf '%s\n' "${loc##*/releases/tag/}" ;;
        ?*) printf '%s\n' "-" ;;
    esac
}

# check_updates FILE — one line per plugin location in FILE. Returns 0 when
# every checked pin is current, 1 when at least one has a newer release, 2 when
# nothing could be checked. Stops at the first unanswered request, so an
# offline machine waits for one timeout at most.
check_updates() {
    if [ ! -r "$1" ]; then echo "zj: can't read $1" >&2; return 2; fi
    printf 'Plugin pins in %s:\n' "$1"
    newer=0 checked=0 failed=0
    locs=$(grep -vE '^[[:space:]]*//' "$1" | grep -oE 'location="(https?|file):[^"]+"' \
             | sed 's/^location="//; s/"$//' | sort -u)
    while IFS= read -r loc; do
        case "$loc" in
            "") continue ;;
            https://github.com/*/*/releases/download/*/*)
                rest=${loc#https://github.com/}
                repo=$(printf '%s' "$rest" | cut -d/ -f1-2)
                pinned=$(printf '%s' "$rest" | cut -d/ -f5)
                latest=$(latest_tag "$repo")
                case "$latest" in
                    "")  printf '  %-16s %-10s no answer from GitHub (offline, or the repo is gone)\n' "${repo#*/}" "$pinned"
                         failed=1; break ;;
                    -)   printf '  %-16s %-10s no published release found\n' "${repo#*/}" "$pinned" ;;
                    "$pinned") printf '  %-16s %-10s current\n' "${repo#*/}" "$pinned" ;;
                    *)   printf '  %-16s %-10s -> %s available: https://github.com/%s/releases/tag/%s\n' \
                                "${repo#*/}" "$pinned" "$latest" "$repo" "$latest"
                         newer=$((newer + 1)) ;;
                esac
                checked=$((checked + 1)) ;;
            file:*) printf '  %-27s loads from disk, not checked\n' "${loc##*/}" ;;
            *)      printf '  %-27s not a GitHub release URL, not checked\n' "${loc##*/}" ;;
        esac
    done <<EOF
$locs
EOF
    if [ "$newer" -gt 0 ]; then return 1; fi
    if [ "$failed" -eq 1 ] || [ "$checked" -eq 0 ]; then return 2; fi
    return 0
}

if [ "${1:-}" = "--check-updates" ]; then
    file=${2:-$(config_file)}
    if [ -z "$file" ]; then echo "zj: can't tell which config zellij loads (is zellij on PATH?)" >&2; exit 2; fi
    check_updates "$file"
    exit $?
fi

# due — true when the monthly check should run before this start.
due() {
    if [ -n "${ZJ_NO_UPDATE_CHECK:-}" ]; then return 1; fi
    next=$(cat "$STAMP" 2>/dev/null)
    case "$next" in ''|*[!0-9]*) next=0 ;; esac
    [ "$(date +%s)" -ge "$next" ]
}

if due; then
    file=$(config_file)
    if [ -n "$file" ]; then
        report=$(check_updates "$file"); rc=$?
        if [ "$rc" -eq 2 ]; then wait_s=$RECHECK_FAILED; else wait_s=$RECHECK_OK; fi
        mkdir -p "$(dirname -- "$STAMP")" 2>/dev/null &&
            printf '%s\n' "$(( $(date +%s) + wait_s ))" > "$STAMP" 2>/dev/null
        if [ "$rc" -eq 1 ]; then
            printf '%s\n\nNewer plugin releases exist. Nothing was changed; to update, see the\nREADME section "Updating a pinned plugin".\n' "$report"
            if [ -t 0 ] && [ -t 1 ]; then printf 'Press Enter to start zellij... '; read -r _; fi
        fi
    fi
fi
exec zellij "$@"
