// ═══════════════════════════════════════════════════════════════════════════
//  Custom theme template — copy, rename, and edit.
//
//  1. Copy this file to a name ending in .kdl, e.g.  my-custom.kdl
//     (zellij only loads *.kdl files from this folder — left as
//     .kdl.example it is silently ignored and you get the default colors).
//  2. Reference the theme by the name used INSIDE the file (below:
//     "my-custom"), not the filename, in config.kdl:
//
//    theme "my-custom"
//
//  With local preferences, select it using
//    python3 tools/manage.py configure --config-dir . --theme my-custom
//  and start a NEW session through zj (Windows: python / zj.cmd). A saved
//  theme preference overrides the shared theme line. The theme file must be in
//  the selected resource directory's themes/ folder. The optional zjstatus bar
//  has its own colors and does not inherit this palette.
//
//  (Verified on 0.45.1: copied as my-custom.kdl it renders — e.g. the focused
//  pane's frame turns pink.)
//
//  Each color is RGB: three numbers 0–255, space-separated.
//  Theme components are documented at:
//    https://zellij.dev/documentation/themes.html
//
//  This file is a starter — Catppuccin Mocha is already built into zellij,
//  so you don't need a file for it. Delete this if you don't plan to make
//  your own.
// ═══════════════════════════════════════════════════════════════════════════

themes {
    my-custom {
        // Foreground / background pair used everywhere by default.
        text_unselected {
            base       205 214 244     // text (Catppuccin Mocha "text")
            background 30 30 46        // base
            emphasis_0 245 194 231     // pink
            emphasis_1 137 220 235     // sky
            emphasis_2 166 227 161     // green
            emphasis_3 249 226 175     // yellow
        }
        text_selected {
            base       205 214 244
            background 49 50 68        // surface0
            emphasis_0 245 194 231
            emphasis_1 137 220 235
            emphasis_2 166 227 161
            emphasis_3 249 226 175
        }
        // Ribbon / tab styling
        ribbon_unselected {
            base       205 214 244
            background 49 50 68
            emphasis_0 245 194 231
            emphasis_1 137 220 235
            emphasis_2 166 227 161
            emphasis_3 249 226 175
        }
        ribbon_selected {
            base       30 30 46
            background 166 227 161     // green — the highlight color
            emphasis_0 245 194 231
            emphasis_1 137 220 235
            emphasis_2 245 194 231
            emphasis_3 249 226 175
        }
        // ⚠ REQUIRED FIELDS (verified on zellij 0.45.1): every component you
        // include must set `base` AND all four `emphasis_0`..`emphasis_3` —
        // a shorthand like `frame_selected { base 245 194 231; }` fails with
        // "Missing theme color: emphasis_0". `background` is optional.
        // Omitting a whole component is fine: it falls back to zellij's stock
        // colors (which won't match your palette).

        // Component tables and lists (session manager, plugin manager, etc).
        table_title {   // pink heading
            base       245 194 231
            emphasis_0 245 194 231     // pink
            emphasis_1 137 220 235     // sky
            emphasis_2 166 227 161     // green
            emphasis_3 249 226 175     // yellow
        }
        table_cell_unselected {
            base       205 214 244
            background 30 30 46
            emphasis_0 245 194 231     // pink
            emphasis_1 137 220 235     // sky
            emphasis_2 166 227 161     // green
            emphasis_3 249 226 175     // yellow
        }
        table_cell_selected {
            base       30 30 46
            background 245 194 231
            emphasis_0 245 194 231     // pink
            emphasis_1 137 220 235     // sky
            emphasis_2 166 227 161     // green
            emphasis_3 249 226 175     // yellow
        }
        list_unselected {
            base       205 214 244
            background 30 30 46
            emphasis_0 245 194 231     // pink
            emphasis_1 137 220 235     // sky
            emphasis_2 166 227 161     // green
            emphasis_3 249 226 175     // yellow
        }
        list_selected {
            base       30 30 46
            background 245 194 231
            emphasis_0 245 194 231     // pink
            emphasis_1 137 220 235     // sky
            emphasis_2 166 227 161     // green
            emphasis_3 249 226 175     // yellow
        }

        // Pane frame colors: unselected panes, the focused pane, and
        // highlighted frames (e.g. panes marked for grouping).
        frame_unselected {   // overlay0
            base       108 112 134
            emphasis_0 245 194 231     // pink
            emphasis_1 137 220 235     // sky
            emphasis_2 166 227 161     // green
            emphasis_3 249 226 175     // yellow
        }
        frame_selected {   // pink
            base       245 194 231
            emphasis_0 245 194 231     // pink
            emphasis_1 137 220 235     // sky
            emphasis_2 166 227 161     // green
            emphasis_3 249 226 175     // yellow
        }
        frame_highlight {   // yellow
            base       249 226 175
            emphasis_0 245 194 231     // pink
            emphasis_1 137 220 235     // sky
            emphasis_2 166 227 161     // green
            emphasis_3 249 226 175     // yellow
        }

        // The exit-code markers shown on panes whose command has finished.
        exit_code_success {   // green
            base       166 227 161
            emphasis_0 245 194 231     // pink
            emphasis_1 137 220 235     // sky
            emphasis_2 166 227 161     // green
            emphasis_3 249 226 175     // yellow
        }
        exit_code_error {   // red
            base       243 139 168
            emphasis_0 245 194 231     // pink
            emphasis_1 137 220 235     // sky
            emphasis_2 166 227 161     // green
            emphasis_3 249 226 175     // yellow
        }

        // Cursor colors for collaborative (multiplayer) sessions — one per
        // connected user.
        multiplayer_user_colors {
            player_1 245 194 231
            player_2 137 220 235
            player_3 166 227 161
            player_4 249 226 175
            player_5 250 179 135
            player_6 203 166 247
            player_7 235 160 172
            player_8 148 226 213
            player_9 137 180 250
            player_10 116 199 236
        }
    }
}
