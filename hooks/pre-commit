#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
#  Git pre-commit hook — runs ./check.sh on the STAGED files before every
#  commit and blocks the commit if it flags anything.
#
#  Enable it once per clone (the hook lives in the repo, so it stays in sync):
#      git config core.hooksPath hooks
#  Skip it for a single commit:
#      git commit --no-verify
#  Disable it again:
#      git config --unset core.hooksPath
#
#  Python 3.10+ and Zellij are required: missing validation tools block the
#  commit. Config, layouts/swaps and the example theme use Zellij's parser.
#  Works under Git Bash too. ZJ_PYTHON and ZJ_ZELLIJ_BIN select validation tools.
#  This invokes repository validation, not the full unittest or linter suite.
# ─────────────────────────────────────────────────────────────────────────────

# Check what is STAGED — exactly what the commit will contain — not the working
# folder. Otherwise a broken file that's staged but "fixed" without staging
# would pass, and an unrelated unstaged edit could block a good commit (both
# verified). `git checkout-index` exports the staged snapshot into a temp dir,
# and check.sh runs there (it always works relative to its own location).
# Untracked local preferences are absent from the staged snapshot; the hook
# validates the shared files rather than a developer's private rendered choices.
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

snap=$(mktemp -d "${TMPDIR:-/tmp}/zellij-precommit.XXXXXX") || exit 1
trap 'rm -rf "$snap"' EXIT INT TERM
git checkout-index --all --prefix="$snap/" || exit 1

if [ ! -f "$snap/check.sh" ]; then
    echo "pre-commit: required check.sh is missing from the staged snapshot." >&2
    exit 1
fi

# Show the full report only when something is wrong; stay quiet when clean.
if out=$(sh "$snap/check.sh" 2>&1); then
    exit 0
fi
# Keep the complete diagnostic when validation fails.
printf '%s\n' "$out" >&2
echo "" >&2
echo "pre-commit: check.sh found problems (above) — commit blocked." >&2
echo "            Fix them, or commit anyway with: git commit --no-verify" >&2
exit 1
